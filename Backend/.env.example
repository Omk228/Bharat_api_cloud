# Application Environment Configuration
NODE_ENV=development
PORT=5002

# CORS Configuration (Client URL)
CORS_ORIGIN=http://localhost:5173,http://localhost:3000

# MySQL Database Configuration
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password
