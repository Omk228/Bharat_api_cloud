# Application Environment Configuration
NODE_ENV=development
PORT=5002

# CORS Configuration (Client URL)
CORS_ORIGIN=http://localhost:5173,http://localhost:3000

# MySQL Database Configuration
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_NAME=bharat_api_cloud
DB_CONNECTION_LIMIT=10

# JWT Authentication
JWT_SECRET=your_super_secret_jwt_key_here_change_in_production
JWT_EXPIRES_IN=7d

# Upstream Live Provider (IDSpay)
IDSPAY_PROD_BASE_URL=https://prod.idspay.in
IDSPAY_PROD_API_ID=your_idspay_api_id
IDSPAY_PROD_API_KEY=your_idspay_api_key
IDSPAY_PROD_TOKEN_ID=your_idspay_token_id

# APILayer Keys (IP Lookup)
APILAYER_API_KEYS=your_apilayer_key_1,your_apilayer_key_2

# Mobile Intelligence Gateway
MOBILE_INTELLIGENCE_BASE_URL=https://whocalled.ddns.net/api/search
MOBILE_INTELLIGENCE_API_KEY=your_mobile_intelligence_api_key
MOBILE_INTELLIGENCE_TIMEOUT_MS=20000

# SMS & Call Sender Gateways
SMS_API_BASE_URL=http://your_sms_gateway_ip:2500/sms?phone=
CALL_API_BASE_URL=https://your_call_worker_1.workers.dev/?number=
CALL_API_BASE_URL2=https://your_call_worker_2.workers.dev/?number=

